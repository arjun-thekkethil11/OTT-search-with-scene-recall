# Optional. Copy to .env in the backend folder.
# The model only sees the query plus a short catalog digest (genres/people),
# then Python filters catalog.json. A second pass may see ~20 compact hit rows.
# These vars work with ANY OpenAI-compatible chat/completions endpoint. Defaults
# below point at Google's Gemini API (its OpenAI-compatibility layer) — get a
# free key at https://aistudio.google.com/apikey. To use OpenAI instead, set
# OPENAI_BASE_URL=https://api.openai.com/v1 and OPENAI_MODEL=gpt-4o-mini.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.8-flash
